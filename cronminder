#!/usr/bin/env bash
# ==============================================================================
# Cronminder - Stateful Scheduled Task & Backup Reminder CLI
# ==============================================================================

set -euo pipefail

STATE_FILE="$HOME/.last_backup_week"

# Helper for formatted printing
show_banner() {
    echo -e "\033[1;33m════════════════════════════════════════════════════════════\033[0m"
    echo -e "\033[1;31m🔔 WEEKLY BACKUP REMINDER\033[0m"
    echo -e "\033[0;36m   This week's backup has not been completed yet!\033[0m"
    echo -e "\033[0;36m   Run \033[1;37mbackup-vm.sh\033[0;36m to complete your weekly backup.\033[0m"
    echo -e "\033[1;33m════════════════════════════════════════════════════════════\033[0m"
}

cmd_check() {
    local day_of_week
    local hour
    day_of_week=$(date +%u)
    hour=$(date +%-H)

    # Triggers Monday 9:00 AM onwards through rest of week if pending
    if [[ ($day_of_week -eq 1 && $hour -ge 9) || $day_of_week -gt 1 ]]; then
        local current_week
        local last_backup_week=""
        current_week=$(date +%V)

        if [[ -f "$STATE_FILE" ]]; then
            last_backup_week=$(cat "$STATE_FILE" 2>/dev/null || true)
        fi

        if [[ "$last_backup_week" != "$current_week" ]]; then
            show_banner
        fi
    fi
}

cmd_status() {
    local current_week
    current_week=$(date +%V)
    echo -e "\033[1;34mCronminder Status:\033[0m"
    echo -e "  Current ISO Week : \033[1;37m$current_week\033[0m"
    if [[ -f "$STATE_FILE" ]]; then
        local last_week
        last_week=$(cat "$STATE_FILE" 2>/dev/null || true)
        echo -e "  Recorded Week    : \033[1;32m$last_week\033[0m"
        if [[ "$last_week" == "$current_week" ]]; then
            echo -e "  Status           : \033[1;32m✓ Up to date (Reminder silent)\033[0m"
        else
            echo -e "  Status           : \033[1;31m✗ Backup pending for week $current_week\033[0m"
        fi
    else
        echo -e "  Recorded Week    : \033[1;33mNone (~/.last_backup_week missing)\033[0m"
        echo -e "  Status           : \033[1;31m✗ Backup pending for week $current_week\033[0m"
    fi
}

cmd_done() {
    local current_week
    current_week=$(date +%V)
    echo "$current_week" > "$STATE_FILE"
    echo -e "\033[1;32m✓ Marked week $current_week backup as complete in $STATE_FILE\033[0m"
}

cmd_reset() {
    rm -f "$STATE_FILE"
    echo -e "\033[1;33m✓ State file $STATE_FILE removed. Reminder will trigger on next check.\033[0m"
}

cmd_test() {
    echo -e "\033[1;35m[Simulated Banner Test]\033[0m"
    show_banner
}

cmd_help() {
    echo "Cronminder - Stateful Scheduled Task & Backup Reminder CLI"
    echo ""
    echo "Usage: cronminder <command>"
    echo ""
    echo "Commands:"
    echo "  check   - Run scheduled check (silently checks state & displays banner if pending)"
    echo "  status  - Display current backup status and recorded ISO week"
    echo "  done    - Mark current week backup as complete"
    echo "  reset   - Reset state (removes ~/.last_backup_week)"
    echo "  test    - Force display the reminder banner for visual testing"
    echo "  help    - Show this help message"
}

case "${1:-check}" in
    check)   cmd_check ;;
    status)  cmd_status ;;
    done)    cmd_done ;;
    reset)   cmd_reset ;;
    test)    cmd_test ;;
    help|-h|--help) cmd_help ;;
    *)
        echo "Unknown command: $1" >&2
        cmd_help
        exit 1
        ;;
esac
