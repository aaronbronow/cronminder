#!/usr/bin/env bash
# ==============================================================================
# Cronminder - Generic Declarative Stateful Scheduled Task & Textual Reminder CLI
# ==============================================================================

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/cronminder"
STATE_FILE="$CONFIG_DIR/state"
LEGACY_STATE_FILE="$HOME/.last_backup_week"
TASKS_DIR="$CONFIG_DIR/tasks.d"
TASKS_CONF="$CONFIG_DIR/tasks.conf"
LEGACY_CONF="$HOME/.cronminder.conf"

# Ensure config directory structure exists
mkdir -p "$CONFIG_DIR" "$TASKS_DIR/hourly" "$TASKS_DIR/daily" "$TASKS_DIR/weekly" "$TASKS_DIR/monthly" 2>/dev/null || true

# ------------------------------------------------------------------------------
# Helpers: Dates & Period Keys
# ------------------------------------------------------------------------------
get_date_info() {
    # Returns: minute hour day_of_month month day_of_week iso_week iso_year year
    # day_of_week: 1=Monday, 7=Sunday
    local min hour dom month dow iso_week year
    min=$(date +%-M)
    hour=$(date +%-H)
    dom=$(date +%-d)
    month=$(date +%-m)
    dow=$(date +%u)
    iso_week=$(date +%V)
    year=$(date +%Y)
    echo "$min $hour $dom $month $dow $iso_week $year"
}

get_period_key() {
    local freq="$1"
    read -r min hour dom month dow iso_week year <<< "$(get_date_info)"

    case "$freq" in
        hourly)
            printf "%s%02d%02d%02d" "$year" "$month" "$dom" "$hour"
            ;;
        daily)
            printf "%s%02d%02d" "$year" "$month" "$dom"
            ;;
        weekly)
            printf "%s-%s" "$year" "$iso_week"
            ;;
        monthly)
            printf "%s%02d" "$year" "$month"
            ;;
        *)
            printf "%s%02d%02d" "$year" "$month" "$dom"
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Helpers: State File Management
# ------------------------------------------------------------------------------
get_task_state() {
    local task_id="$1"
    local val=""

    if [[ -f "$STATE_FILE" ]]; then
        val=$(grep "^${task_id}=" "$STATE_FILE" 2>/dev/null | head -n1 | cut -d'=' -f2- || true)
    fi

    # Migration fallback for legacy state file if task_id matches legacy file
    if [[ -z "$val" && -f "$LEGACY_STATE_FILE" && ("$task_id" == "backup" || "$task_id" == "weekly") ]]; then
        val=$(cat "$LEGACY_STATE_FILE" 2>/dev/null || true)
    fi

    echo "$val"
}

set_task_state() {
    local task_id="$1"
    local period_key="$2"

    mkdir -p "$(dirname "$STATE_FILE")" 2>/dev/null || true

    local tmp_file="${STATE_FILE}.tmp"
    if [[ -f "$STATE_FILE" ]]; then
        grep -v "^${task_id}=" "$STATE_FILE" > "$tmp_file" 2>/dev/null || true
    else
        touch "$tmp_file"
    fi
    echo "${task_id}=${period_key}" >> "$tmp_file"
    mv "$tmp_file" "$STATE_FILE"

    # Sync legacy file if task is backup or weekly
    if [[ "$task_id" == "backup" || "$task_id" == "weekly" ]]; then
        echo "$period_key" > "$LEGACY_STATE_FILE"
    fi
}

remove_task_state() {
    local task_id="$1"
    if [[ -f "$STATE_FILE" ]]; then
        local tmp_file="${STATE_FILE}.tmp"
        grep -v "^${task_id}=" "$STATE_FILE" > "$tmp_file" 2>/dev/null || true
        mv "$tmp_file" "$STATE_FILE"
    fi
    if [[ "$task_id" == "backup" || "$task_id" == "weekly" || "$task_id" == "all" ]]; then
        rm -f "$LEGACY_STATE_FILE"
    fi
}

# ------------------------------------------------------------------------------
# Helpers: Cron Expression Evaluator
# ------------------------------------------------------------------------------
match_cron_field() {
    local val="$1"
    local pattern="$2"

    if [[ "$pattern" == "*" ]]; then
        return 0
    fi

    # Step values: */N
    if [[ "$pattern" =~ ^\*/([0-9]+)$ ]]; then
        local step="${BASH_REMATCH[1]}"
        if [[ $step -ne 0 && $((val % step)) -eq 0 ]]; then
            return 0
        fi
        return 1
    fi

    # Lists: A,B,C
    if [[ "$pattern" == *","* ]]; then
        IFS=',' read -ra parts <<< "$pattern"
        for part in "${parts[@]}"; do
            if match_cron_field "$val" "$part"; then
                return 0
            fi
        done
        return 1
    fi

    # Ranges: X-Y
    if [[ "$pattern" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        local start="${BASH_REMATCH[1]}"
        local end="${BASH_REMATCH[2]}"
        if [[ $val -ge $start && $val -le $end ]]; then
            return 0
        fi
        return 1
    fi

    # Direct match
    if [[ "$pattern" =~ ^[0-9]+$ && $val -eq $pattern ]]; then
        return 0
    fi

    return 1
}

match_cron_schedule() {
    local cron_expr="$1"
    read -r cur_min cur_hour cur_dom cur_month cur_dow cur_iso_week cur_year <<< "$(get_date_info)"

    # Handle aliases
    case "$cron_expr" in
        "@hourly")  cron_expr="0 * * * *" ;;
        "@daily")   cron_expr="0 0 * * *" ;;
        "@weekly")  cron_expr="0 0 * * 0" ;;
        "@monthly") cron_expr="0 0 1 * *" ;;
    esac

    read -r c_min c_hour c_dom c_month c_dow <<< "$cron_expr"

    match_cron_field "$cur_min" "$c_min" && \
    match_cron_field "$cur_hour" "$c_hour" && \
    match_cron_field "$cur_dom" "$c_dom" && \
    match_cron_field "$cur_month" "$c_month" && \
    match_cron_field "$cur_dow" "$c_dow"
}

# ------------------------------------------------------------------------------
# Task Registry Loader
# ------------------------------------------------------------------------------
# Returns task records formatted as:
# TASK_ID|FREQUENCY|CRON_EXPR|TITLE|PAYLOAD
load_tasks() {
    # 1. Scan tasks.d/ directories
    for freq in hourly daily weekly monthly; do
        local dir="$TASKS_DIR/$freq"
        if [[ -d "$dir" ]]; then
            for file in "$dir"/*; do
                if [[ -f "$file" ]]; then
                    local task_id
                    task_id=$(basename "$file")
                    # strip extension if present
                    task_id="${task_id%.*}"

                    local cron_expr="0 * * * *"
                    case "$freq" in
                        hourly)  cron_expr="0 * * * *" ;;
                        daily)   cron_expr="0 0 * * *" ;;
                        weekly)  cron_expr="0 9 * * 1" ;;
                        monthly) cron_expr="0 0 1 * *" ;;
                    esac

                    local title="${freq^} Task: $task_id"
                    local payload
                    payload=$(cat "$file" 2>/dev/null || true)
                    if [[ -z "$payload" ]]; then
                        payload="Reminder: Task $task_id is due!"
                    fi

                    # Escape newlines for record parsing
                    payload="${payload//$'\n'/\\n}"
                    echo "${task_id}|${freq}|${cron_expr}|${title}|${payload}"
                fi
            done
        fi
    done

    # 2. Read tasks.conf or ~/.cronminder.conf
    local conf_file=""
    if [[ -f "$TASKS_CONF" ]]; then
        conf_file="$TASKS_CONF"
    elif [[ -f "$LEGACY_CONF" ]]; then
        conf_file="$LEGACY_CONF"
    fi

    if [[ -n "$conf_file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            # Trim whitespace
            line=$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            [[ -z "$line" || "$line" == "#"* ]] && continue

            if [[ "$line" == *"|"* ]]; then
                IFS='|' read -r cron_expr task_id title payload <<< "$line"
                cron_expr=$(echo "$cron_expr" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                task_id=$(echo "$task_id" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                title=$(echo "$title" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
                payload=$(echo "$payload" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

                local freq="custom"
                case "$cron_expr" in
                    "@hourly"|"0 * * * *") freq="hourly" ;;
                    "@daily"|"0 0 * * *")  freq="daily" ;;
                    "@weekly"|"0 9 * * 1"|"0 0 * * 0") freq="weekly" ;;
                    "@monthly"|"0 0 1 * *") freq="monthly" ;;
                esac

                payload="${payload//$'\n'/\\n}"
                echo "${task_id}|${freq}|${cron_expr}|${title}|${payload}"
            fi
        done < "$conf_file"
    fi
}

# ------------------------------------------------------------------------------
# Check Task Active Status
# ------------------------------------------------------------------------------
is_task_due() {
    local task_id="$1"
    local freq="$2"
    local cron_expr="$3"

    read -r cur_min cur_hour cur_dom cur_month cur_dow cur_iso_week cur_year <<< "$(get_date_info)"
    local cur_period
    cur_period=$(get_period_key "$freq")

    local recorded_state
    recorded_state=$(get_task_state "$task_id")

    # If state matches current period key, task is already complete!
    if [[ -n "$recorded_state" && "$recorded_state" == "$cur_period" ]]; then
        return 1
    fi

    # Active window logic for weekly task (Monday 9:00 AM onwards through rest of week)
    if [[ "$freq" == "weekly" ]]; then
        if [[ ($cur_dow -eq 1 && $cur_hour -ge 9) || $cur_dow -gt 1 ]]; then
            return 0
        fi
        return 1
    fi

    # Daily tasks active every day if not done for current period
    if [[ "$freq" == "daily" ]]; then
        return 0
    fi

    # Hourly tasks active every hour if not done for current period
    if [[ "$freq" == "hourly" ]]; then
        return 0
    fi

    # Monthly tasks active every month if not done
    if [[ "$freq" == "monthly" ]]; then
        return 0
    fi

    # Custom cron matching
    if match_cron_schedule "$cron_expr"; then
        return 0
    fi

    return 1
}

# ------------------------------------------------------------------------------
# Formatting & Banner Rendering
# ------------------------------------------------------------------------------
show_single_banner() {
    local title="$1"
    local payload="$2"

    # Unescape newlines
    payload="${payload//\\n/$'\n'}"

    echo -e "\033[1;33m════════════════════════════════════════════════════════════\033[0m"
    echo -e "\033[1;31m🔔 ${title^^}\033[0m"
    while IFS= read -r line; do
        echo -e "\033[0;36m   ${line}\033[0m"
    done <<< "$payload"
    echo -e "\033[1;33m════════════════════════════════════════════════════════════\033[0m"
}

show_dashboard_box() {
    local task_records=("$@")

    echo -e "\033[1;33m╔════════════════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;31m🔔 CRONMINDER DASHBOARD: ${#task_records[@]} PENDING REMINDERS\033[0m"
    echo -e "\033[1;33m╠════════════════════════════════════════════════════════════╣\033[0m"

    for record in "${task_records[@]}"; do
        IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "$record"
        t_payload="${t_payload//\\n/ }"
        echo -e "\033[1;37m  • [${t_id}] \033[1;36m${t_title}\033[0m"
        echo -e "\033[0;33m    └─ ${t_payload}\033[0m"
    done
    echo -e "\033[1;33m╚════════════════════════════════════════════════════════════╝\033[0m"
}

# ------------------------------------------------------------------------------
# CLI Subcommands
# ------------------------------------------------------------------------------
cmd_check() {
    local filter_mode="${CRONMINDER_FILTER_MODE:-all}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --today) filter_mode="today"; shift ;;
            --upcoming) filter_mode="upcoming"; shift ;;
            --recent) filter_mode="recent"; shift ;;
            *) shift ;;
        esac
    done

    local active_records=()
    read -r cur_min cur_hour cur_dom cur_month cur_dow cur_iso_week cur_year <<< "$(get_date_info)"

    while IFS= read -r record || [[ -n "$record" ]]; do
        [[ -z "$record" ]] && continue
        IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "$record"

        if is_task_due "$t_id" "$t_freq" "$t_cron"; then
            if [[ "$filter_mode" == "today" && "$t_freq" == "monthly" && $cur_dom -ne 1 ]]; then
                continue
            fi
            active_records+=("$record")
        fi
    done < <(load_tasks)

    if [[ ${#active_records[@]} -eq 1 ]]; then
        IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "${active_records[0]}"
        show_single_banner "$t_title" "$t_payload"
    elif [[ ${#active_records[@]} -gt 1 ]]; then
        show_dashboard_box "${active_records[@]}"
    fi
}

cmd_status() {
    local filter_mode="${CRONMINDER_FILTER_MODE:-all}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --today) filter_mode="today"; shift ;;
            --upcoming) filter_mode="upcoming"; shift ;;
            --recent) filter_mode="recent"; shift ;;
            *) shift ;;
        esac
    done

    read -r cur_min cur_hour cur_dom cur_month cur_dow cur_iso_week cur_year <<< "$(get_date_info)"

    echo -e "\033[1;34mCronminder Status Dashboard:\033[0m"
    echo -e "  Current Time     : \033[1;37m${cur_year}-${cur_month}-${cur_dom} ${cur_hour}:${cur_min} (ISO W${cur_iso_week}, Day ${cur_dow})\033[0m"
    echo -e "  Config Directory : \033[1;37m${CONFIG_DIR}\033[0m"
    echo -e "  Filter Mode      : \033[1;37m${filter_mode}\033[0m"
    echo ""

    local count=0
    printf "\033[1;33m  %-12s %-10s %-12s %-14s %-20s\033[0m\n" "TASK ID" "FREQ" "SCHEDULE" "PERIOD KEY" "STATUS"
    echo -e "\033[1;33m  -------------------------------------------------------------------\033[0m"

    while IFS= read -r record || [[ -n "$record" ]]; do
        [[ -z "$record" ]] && continue
        count=$((count + 1))
        IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "$record"

        local cur_period
        cur_period=$(get_period_key "$t_freq")
        local rec_state
        rec_state=$(get_task_state "$t_id")
        [[ -z "$rec_state" ]] && rec_state="None"

        local status_str=""
        if [[ "$rec_state" == "$cur_period" ]]; then
            status_str="\033[1;32m✓ Up to date\033[0m"
        elif is_task_due "$t_id" "$t_freq" "$t_cron"; then
            status_str="\033[1;31m✗ Pending\033[0m"
        else
            status_str="\033[0;36m- Scheduled\033[0m"
        fi

        printf "  %-12s %-10s %-12s %-14s %b\n" "$t_id" "$t_freq" "$t_cron" "$rec_state" "$status_str"
    done < <(load_tasks)

    if [[ $count -eq 0 ]]; then
        echo -e "\033[0;36m  (No tasks configured. Add text files to ~/.config/cronminder/tasks.d/ or edit tasks.conf)\033[0m"
    fi
    echo ""
}

cmd_system() {
    echo -e "\033[1;34mSystem Cron Environment Scan:\033[0m"
    echo -e "\033[1;33m════════════════════════════════════════════════════════════\033[0m"

    # 1. User Crontab
    echo -e "\033[1;36m[User Crontab (crontab -l)]\033[0m"
    if command -v crontab >/dev/null 2>&1; then
        local user_cron
        user_cron=$(crontab -l 2>/dev/null || true)
        if [[ -n "$user_cron" ]]; then
            echo "$user_cron" | grep -v '^#' | grep -v '^[[:space:]]*$' || echo "  (No active uncommented entries)"
        else
            echo "  (No user crontab found)"
        fi
    else
        echo "  (crontab utility not installed)"
    fi
    echo ""

    # 2. Registered Cronminder Tasks
    echo -e "\033[1;36m[Cronminder Configured Tasks]\033[0m"
    local count=0
    while IFS= read -r record || [[ -n "$record" ]]; do
        [[ -z "$record" ]] && continue
        count=$((count + 1))
        IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "$record"
        printf "  • %-12s (%-8s) schedule: %-12s - %s\n" "$t_id" "$t_freq" "$t_cron" "$t_title"
    done < <(load_tasks)
    if [[ $count -eq 0 ]]; then
        echo "  (No tasks configured in ~/.config/cronminder/)"
    fi
    echo ""

    # 3. System Crontab Files (/etc/crontab, /etc/cron.d/*)
    echo -e "\033[1;36m[System Crontabs (/etc/crontab, /etc/cron.d)]\033[0m"
    if [[ -f /etc/crontab && -r /etc/crontab ]]; then
        echo "  /etc/crontab:"
        grep -v '^#' /etc/crontab | grep -v '^[[:space:]]*$' | sed 's/^/    /' || true
    fi

    if [[ -d /etc/cron.d && -r /etc/cron.d ]]; then
        for f in /etc/cron.d/*; do
            if [[ -f "$f" && -r "$f" ]]; then
                echo "  $f:"
                grep -v '^#' "$f" | grep -v '^[[:space:]]*$' | sed 's/^/    /' || true
            fi
        done
    fi
    echo -e "\033[1;33m════════════════════════════════════════════════════════════\033[0m"
}

cmd_done() {
    local target_id="${1:-}"

    if [[ -n "$target_id" && "$target_id" != "all" ]]; then
        local found=0
        while IFS= read -r record || [[ -n "$record" ]]; do
            [[ -z "$record" ]] && continue
            IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "$record"
            if [[ "$t_id" == "$target_id" ]]; then
                found=1
                local cur_period
                cur_period=$(get_period_key "$t_freq")
                set_task_state "$t_id" "$cur_period"
                echo -e "\033[1;32m✓ Marked task '$t_id' as complete for period $cur_period\033[0m"
                break
            fi
        done < <(load_tasks)

        if [[ $found -eq 0 ]]; then
            # Mark anyway with default weekly key
            read -r cur_min cur_hour cur_dom cur_month cur_dow cur_iso_week cur_year <<< "$(get_date_info)"
            set_task_state "$target_id" "${cur_year}-${cur_iso_week}"
            echo -e "\033[1;32m✓ Marked task '$target_id' as complete in $STATE_FILE\033[0m"
        fi
    else
        # Mark all active due tasks as complete
        local count=0
        while IFS= read -r record || [[ -n "$record" ]]; do
            [[ -z "$record" ]] && continue
            IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "$record"
            local cur_period
            cur_period=$(get_period_key "$t_freq")
            set_task_state "$t_id" "$cur_period"
            count=$((count + 1))
        done < <(load_tasks)
        echo -e "\033[1;32m✓ Marked $count task(s) as complete in $STATE_FILE\033[0m"
    fi
}

cmd_reset() {
    local target_id="${1:-}"
    if [[ -n "$target_id" && "$target_id" != "all" ]]; then
        remove_task_state "$target_id"
        echo -e "\033[1;33m✓ State for task '$target_id' removed.\033[0m"
    else
        rm -f "$STATE_FILE" "$LEGACY_STATE_FILE"
        echo -e "\033[1;33m✓ All state files removed. Reminders will trigger on next check.\033[0m"
    fi
}

cmd_test() {
    echo -e "\033[1;35m[Simulated Banner Test]\033[0m"
    local records=()
    while IFS= read -r record || [[ -n "$record" ]]; do
        [[ -n "$record" ]] && records+=("$record")
    done < <(load_tasks)

    if [[ ${#records[@]} -eq 0 ]]; then
        show_single_banner "Sample Task Reminder" "This is a sample test banner.\nAdd your task files to ~/.config/cronminder/tasks.d/ or ~/.config/cronminder/tasks.conf!"
    elif [[ ${#records[@]} -eq 1 ]]; then
        IFS='|' read -r t_id t_freq t_cron t_title t_payload <<< "${records[0]}"
        show_single_banner "$t_title" "$t_payload"
    else
        show_dashboard_box "${records[@]}"
    fi
}

cmd_help() {
    echo "Cronminder - Declarative Stateful Scheduled Task & Textual Reminder CLI"
    echo ""
    echo "Usage: cronminder <command> [options]"
    echo ""
    echo "Commands:"
    echo "  check [--today|--upcoming|--recent] - Perform scheduled check and display banners/dashboard"
    echo "  status [--today|--upcoming]        - Display current task status dashboard"
    echo "  system                             - Display overview of user & system crontab schedules"
    echo "  done [task_id]                     - Mark task (or all active tasks) as complete"
    echo "  reset [task_id]                    - Reset completion state for task or all tasks"
    echo "  test [task_id]                     - Force display task reminder banner/dashboard for testing"
    echo "  help                               - Show this help message"
}

# ------------------------------------------------------------------------------
# Dispatcher
# ------------------------------------------------------------------------------
cmd="${1:-check}"
shift 2>/dev/null || true

case "$cmd" in
    check)   cmd_check "$@" ;;
    status)  cmd_status "$@" ;;
    system)  cmd_system "$@" ;;
    done)    cmd_done "$@" ;;
    reset)   cmd_reset "$@" ;;
    test)    cmd_test "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        echo "Unknown command: $cmd" >&2
        cmd_help
        exit 1
        ;;
esac
